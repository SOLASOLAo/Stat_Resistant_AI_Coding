      </HmiText>
      <HmiText name="ForceTraceSamplingRule">
        <Text lcid="1033" value="PLC sampling: once per task cycle; configured cycle for this record: {0} ms. HMI displays PLC results." />
        <Text lcid="2052" value="PLC采样：每个任务周期一次；本次记录配置周期：{0} ms。HMI显示PLC计算结果。" />
      </HmiText>
      <HmiText name="ForceTraceQualificationRule">
        <Text lcid="1033" value="Stable: cylinder down, data good, force &gt; {0} N, full {1} ms window, and 3σ &lt; {2} N; then resistance measurement may start." />
        <Text lcid="2052" value="判稳标准：下压到位、数据正常、力 &gt; {0} N，统计窗口完整达到 {1} ms，且3σ &lt; {2} N，才允许开始测电阻。" />
      </HmiText>
      <HmiText name="ForceTraceSigmaRule">
        <Text lcid="1033" value="3σ = 3 × √[Σ(Fᵢ − F̄)² / (n − 1)], n = window samples. Force ≤ threshold or bad data resets the window." />
        <Text lcid="2052" value="计算：3σ = 3 × √[Σ(Fᵢ − F̄)² / (n − 1)]，n为窗口样本数；力≤门槛或数据异常时重置窗口。" />
      </HmiText>
      <HmiText name="ForceTraceStatisticsRule">
        <Text lcid="1033" value="PLC updates 3σ through qualification and resistance measurement; DONE/fault freezes statistics. Page opening and PDF drawing do not control qualification." />
        <Text lcid="2052" value="PLC在等待判稳及电阻测量期间持续更新3σ；测量完成或故障后冻结统计。无需提前打开此页，PDF不参与判稳。" />
      </HmiText>
    </HmiTextGroup>
  </HmiTextsDef>
</OpconStdDefinition>