  <Parameters>
    <ParameterValue name="SamplePeriodMs" refId="FCDCFB93-3D7B-4FD0-A128-06827E8B43AB" varType="DINT" variable="true" initialValue="6" minValue="1" maxValue="1000" textEn="PLC sampling task cycle in ms (must match the actual task; does not change it)" textDe="Zyklus der PLC-Abtasttask in ms (muss mit der Task uebereinstimmen)" />
    <ParameterVariable name="ForceN" refId="32FFA1BA-1980-5D08-9BD9-DF5B01EB810D" varType="REAL" optional="False" textEn="Force in N" textDe="Force in N" />
    <ParameterVariable name="QualityGood" refId="9C8A6110-2604-51EF-AF89-A71A4EBEC171" varType="BOOL" optional="False" textEn="Force signal quality is good" textDe="Force signal quality is good" />
    <ParameterVariable name="Measuring" refId="10F90CF3-5580-5A5C-9FCC-67F5B05524F1" varType="BOOL" optional="False" textEn="Acquisition enabled by process sequence" textDe="Acquisition enabled by process sequence" />
    <ParameterVariable name="ThresholdN" refId="5C5CF4E7-7573-50A5-8409-F41E37A01308" varType="REAL" optional="False" textEn="StationData force threshold in N" textDe="StationData force threshold in N" />
    <ParameterVariable name="LimitN" refId="162EC3D0-EE7D-5179-A462-2DDE21230FBD" varType="REAL" optional="False" textEn="StationData 3 sigma limit in N; zero means not configured" textDe="StationData 3 sigma limit in N; zero means not configured" />
    <ParameterVariable name="WindowMs" refId="DFBBABB0-457D-513F-ABCE-FB23720C0F42" varType="DINT" optional="False" textEn="StationData statistics window in ms" textDe="StationData statistics window in ms" />
    <ParameterVariable name="TimeoutMs" refId="E4F5F72F-6D8C-5DF9-9485-90D4A615DCFA" varType="DINT" optional="False" textEn="StationData qualification timeout in ms" textDe="StationData qualification timeout in ms" />
  </Parameters>
</Object>
