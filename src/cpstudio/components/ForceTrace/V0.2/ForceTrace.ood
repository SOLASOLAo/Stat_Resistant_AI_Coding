<?xml version='1.0' encoding='utf-8'?>
<Object xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" objectName="Force Trace" refId="67760EC4-181D-5E04-B4E1-92EF2F1CCD9D" version="0.2.1.0" formatVersion="1" toolVersions="5.11" hierarchyNodeType="AddOn" xsi:noNamespaceSchemaLocation="..\..\OpconOodObjectSchema_V4_11.xsd">
  <Misc>
    <Platform name="Nexeed Automation" />
    <Type name="Add-on" />
    <Picture path="Common\Picture.png" />
    <Author name="WANG Zhi (RBCD\TEF2)" />
    <Vendor name="Internal Engineering" />
    <Visibility value="Always" />
    <Interface name="None" />
    <Description textEn="PLC force acquisition, rolling 3-sigma statistics and three-position HMI traces." textDe="PLC-Krafterfassung, gleitende 3-Sigma-Statistik und HMI-Kurven fuer drei Positionen." />
    <SupportedPlcTypes>
      <PlcType name="CXA" supported="Yes" />
    </SupportedPlcTypes>
  </Misc>
  <Common>
    <BaseRefIds>
      <BaseRefId name="NxAddonBase" refLink="A467FB09-013E-11E1-8619-000423132FC8" version="1.0" />
    </BaseRefIds>
    <UseAs>
      <Unit refLink="62788D21-9837-5490-8CC7-E35C1E1D2816" />
    </UseAs>
    <Templates>
      <ApplyParametersStartup name="Export\StartupParams.otd" />
      <ApplyParametersOnlineChange name="Export\StartupParams.otd" />
    </Templates>
  </Common>
  <Content>
    <Types>
      <CodeEntity name="Addon types" link="Types\CodeEntities.osd" refId="892779D5-E74B-58D3-B96B-A3EE1D551EE4" />
      <Structure name="Trace frames" link="Types\Structures.osd" refId="72C182DF-72BA-513E-8F6F-403227E59456" />
    </Types>
    <Variables>
      <Variable name="" structRef="ForceTraceData" refId="2100A226-47F7-5B3C-826A-1618B09864E2" />
      <Variable name="Addon" structRef="ForceTraceAddon" refId="62788D21-9837-5490-8CC7-E35C1E1D2816" />
    </Variables>
    <Hmi>
      <View name="ForceTrace" refId="75641E86-D7BA-556C-8955-25138AF746AE" file="Views\ForceTrace.sfc" selectable="True">
        <Description>
          <Text lcid="1033" value="Force trace" />
          <Text lcid="2052" value="力曲线" />
        </Description>
      </View>
      <HmiText name="Texts" link="Texts\Texts.osd" refId="DC67D13D-F6C4-5DDD-B18F-907E5264623E" />
