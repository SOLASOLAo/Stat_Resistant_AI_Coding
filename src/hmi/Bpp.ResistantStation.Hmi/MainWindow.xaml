<Window x:Class="Bpp.ResistantStation.Hmi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Bpp.ResistantStation.Hmi.Converters"
        Title="{Binding WindowTitle}"
        Width="1440"
        Height="900"
        MinWidth="1180"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="#EDF1F4"
        FontFamily="Segoe UI">
    <Window.Resources>
        <converters:BooleanToBrushConverter x:Key="BoolBrush" />
        <converters:ModeToBrushConverter x:Key="ModeBrush" />
        <converters:ModeToForegroundConverter x:Key="ModeForeground" />
        <converters:NavigationToBrushConverter x:Key="NavBrush" />
        <converters:UnitStateToBrushConverter x:Key="UnitStateBrush" />
        <converters:PageVisibilityConverter x:Key="PageVisibility" />
        <converters:FixturePositionToBrushConverter x:Key="FixtureBrush" />
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="BorderBrush" Value="#D4DCE3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#8093A3" BlurRadius="8" ShadowDepth="1" Opacity="0.16" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModeButton" TargetType="Button">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="18,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#193249" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#DCE8F0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="72" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#006EA8" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="SubtleButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#DDE6ED" />
            <Setter Property="Foreground" Value="#173148" />
        </Style>

        <Style x:Key="OperatorCommandButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Width" Value="115" />
            <Setter Property="Height" Value="54" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="StartButton" TargetType="Button" BasedOn="{StaticResource OperatorCommandButton}">
            <Setter Property="Background" Value="#23865B" />
        </Style>

        <Style x:Key="StopButton" TargetType="Button" BasedOn="{StaticResource OperatorCommandButton}">
            <Setter Property="Background" Value="#B4423D" />
        </Style>

        <Style x:Key="ManualFunctionButton" TargetType="Button">
            <Setter Property="Background" Value="#F4F7F9" />
            <Setter Property="Foreground" Value="#173148" />
            <Setter Property="BorderBrush" Value="#B9C8D2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="72" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#173148" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6C7E8C" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="42" />
        </Grid.RowDefinitions>

        <!-- Independent brand shell; information hierarchy intentionally mirrors the operator flow. -->
        <Border Grid.Row="0" Background="#112B42">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" Background="#00A4D6" CornerRadius="2" Margin="0,0,12,0">
                        <TextBlock Text="B" Foreground="White" FontSize="23" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="BPP AUTOMATION" Foreground="White" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock Text="AI HMI comparison prototype" Foreground="#9FC0D4" FontSize="11" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StationName}" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StationId}" Foreground="#A7C6D8" FontSize="11" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#F2C94C" Padding="10,4" Margin="0,0,14,0" CornerRadius="2">
                        <TextBlock Text="LIMITED CONTROL / 受控操作" Foreground="#3D350C" FontWeight="Bold" FontSize="11" />
                    </Border>
                    <Ellipse Width="12" Height="12" Margin="0,0,8,0"
                             Fill="{Binding IsConnected, Converter={StaticResource BoolBrush}}" />
                    <TextBlock Text="{Binding ConnectionMessage}" Foreground="White" VerticalAlignment="Center"
                               Width="250" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#173148">
                <StackPanel>
                    <Button Style="{StaticResource NavButton}" Tag="0" Click="OnNavigateClick" AutomationProperties.Name="Navigate Overview"
                            Background="{Binding SelectedPageIndex, Converter={StaticResource NavBrush}, ConverterParameter=0}">
                        <StackPanel><TextBlock Text="▦" FontSize="26" HorizontalAlignment="Center" /><TextBlock Text="OVERVIEW" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Tag="1" Click="OnNavigateClick" AutomationProperties.Name="Navigate Manual"
                            Background="{Binding SelectedPageIndex, Converter={StaticResource NavBrush}, ConverterParameter=1}">
                        <StackPanel><TextBlock Text="↔" FontSize="26" HorizontalAlignment="Center" /><TextBlock Text="MANUAL" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Tag="2" Click="OnNavigateClick" AutomationProperties.Name="Navigate Events"
                            Background="{Binding SelectedPageIndex, Converter={StaticResource NavBrush}, ConverterParameter=2}">
                        <StackPanel><TextBlock Text="⚠" FontSize="24" HorizontalAlignment="Center" /><TextBlock Text="EVENTS" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Tag="3" Click="OnNavigateClick" AutomationProperties.Name="Navigate IO"
                            Background="{Binding SelectedPageIndex, Converter={StaticResource NavBrush}, ConverterParameter=3}">
                        <StackPanel><TextBlock Text="⌁" FontSize="26" HorizontalAlignment="Center" /><TextBlock Text="I/O" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Tag="4" Click="OnNavigateClick" AutomationProperties.Name="Navigate Data"
                            Background="{Binding SelectedPageIndex, Converter={StaticResource NavBrush}, ConverterParameter=4}">
                        <StackPanel><TextBlock Text="⚙" FontSize="25" HorizontalAlignment="Center" /><TextBlock Text="DATA" /></StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="92" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="78" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ModeButton}" Width="150"
                                Tag="1" Click="OnModeClick" IsEnabled="{Binding CanRequestMode}"
                                AutomationProperties.Name="Switch to Automatic mode"
                                Background="{Binding ModeId, Converter={StaticResource ModeBrush}, ConverterParameter=1}"
                                Foreground="{Binding ModeId, Converter={StaticResource ModeForeground}, ConverterParameter=1}">
                            <StackPanel><TextBlock Text="AUTOMATIC" HorizontalAlignment="Center" /><TextBlock Text="自动" FontSize="11" HorizontalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource ModeButton}" Width="150"
                                Tag="3" Click="OnModeClick" IsEnabled="{Binding CanRequestMode}"
                                AutomationProperties.Name="Switch to Manual mode"
                                Background="{Binding ModeId, Converter={StaticResource ModeBrush}, ConverterParameter=3}"
                                Foreground="{Binding ModeId, Converter={StaticResource ModeForeground}, ConverterParameter=3}">
                            <StackPanel><TextBlock Text="MANUAL" HorizontalAlignment="Center" /><TextBlock Text="手动" FontSize="11" HorizontalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource ModeButton}" Width="150"
                                Tag="4" Click="OnModeClick" IsEnabled="{Binding CanRequestMode}"
                                AutomationProperties.Name="Switch to Homing mode"
                                Background="{Binding ModeId, Converter={StaticResource ModeBrush}, ConverterParameter=4}"
                                Foreground="{Binding ModeId, Converter={StaticResource ModeForeground}, ConverterParameter=4}">
                            <StackPanel><TextBlock Text="HOMING" HorizontalAlignment="Center" /><TextBlock Text="回原位" FontSize="11" HorizontalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource ModeButton}" Width="150"
                                Tag="5" Click="OnModeClick" IsEnabled="{Binding CanRequestMode}"
                                AutomationProperties.Name="Switch to Change-over mode"
                                Background="{Binding ModeId, Converter={StaticResource ModeBrush}, ConverterParameter=5}"
                                Foreground="{Binding ModeId, Converter={StaticResource ModeForeground}, ConverterParameter=5}">
                            <StackPanel><TextBlock Text="CHANGE-OVER" HorizontalAlignment="Center" /><TextBlock Text="换型" FontSize="11" HorizontalAlignment="Center" /></StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <TextBlock Text="{Binding EndpointUrl}" VerticalAlignment="Center" Foreground="#607788" Margin="0,0,12,0" />
                        <Button Content="连接设置" Style="{StaticResource PrimaryButton}" Click="OnConnectPlcClick" Margin="0,0,6,0" />
                        <Button Content="演示" Style="{StaticResource SubtleButton}" Click="OnDemoClick" Margin="0,0,6,0" />
                        <Button Content="断开" Style="{StaticResource SubtleButton}" Click="OnDisconnectClick" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="White" BorderBrush="#CFD9E0" BorderThickness="1"
                        CornerRadius="3" Padding="14,10" Margin="0,0,14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="492" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CURRENT OPERATION / 当前操作" Style="{StaticResource Muted}" />
                            <TextBlock Text="{Binding ModeName}" FontSize="17" FontWeight="SemiBold" Foreground="#173148" />
                            <TextBlock Text="{Binding RunStateText}" Foreground="#5C7282" FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,16,0">
                            <TextBlock Text="ACTIVE CHAIN / 活动 Chain" Style="{StaticResource Muted}" />
                            <TextBlock Text="{Binding ActiveChainName}" FontSize="15" FontWeight="SemiBold" Foreground="#173148"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="38" />
                            <TextBlock Text="{Binding StepModeText}" Foreground="#6A7E8C" FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource StartButton}"
                                    IsEnabled="{Binding CanStartChain}" Tag="Start" Click="OnStationCommandClick"
                                    AutomationProperties.Name="Start active mode Chain">
                                <StackPanel><TextBlock Text="▶  START" HorizontalAlignment="Center" /><TextBlock Text="启动" FontSize="11" HorizontalAlignment="Center" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource StopButton}"
                                    IsEnabled="{Binding CanStopChain}" Tag="Stop" Click="OnStationCommandClick"
                                    ToolTip="Cycle stop only — this is not an emergency stop."
                                    AutomationProperties.Name="Stop active mode Chain">
                                <StackPanel><TextBlock Text="■  CYCLE STOP" HorizontalAlignment="Center" /><TextBlock Text="停止" FontSize="11" HorizontalAlignment="Center" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource OperatorCommandButton}"
                                    IsEnabled="{Binding CanToggleStepMode}" Tag="ToggleStep" Click="OnStationCommandClick"
                                    AutomationProperties.Name="Toggle automatic step mode">
                                <StackPanel><TextBlock Text="STEP MODE" HorizontalAlignment="Center" /><TextBlock Text="步进模式" FontSize="11" HorizontalAlignment="Center" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource OperatorCommandButton}"
                                    IsEnabled="{Binding CanPulseStep}" Tag="StepPulse" Click="OnStationCommandClick"
                                    AutomationProperties.Name="Advance one automatic step">
                                <StackPanel><TextBlock Text="NEXT STEP" HorizontalAlignment="Center" /><TextBlock Text="下一步" FontSize="11" HorizontalAlignment="Center" /></StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid Visibility="{Binding SelectedPageIndex, Converter={StaticResource PageVisibility}, ConverterParameter=0}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="0.9*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="STATION OVERVIEW / 工位总览" Style="{StaticResource SectionTitle}" />
                            <Grid Grid.Row="1" Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="0.8*" />
                                    <RowDefinition Height="1.4*" />
                                    <RowDefinition Height="0.9*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Width="230" Height="78" BorderBrush="#385B74" BorderThickness="5,5,5,0" Background="#EAF2F6" HorizontalAlignment="Center">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="SAFETY DOOR / 安全门" HorizontalAlignment="Center" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SafetyDoorState}" HorizontalAlignment="Center" Foreground="#006EA8" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>
                                <Grid Grid.Row="1">
                                    <Rectangle Width="16" Height="115" Fill="#E58A35" HorizontalAlignment="Center" VerticalAlignment="Top" />
                                    <Border Width="130" Height="54" Background="#C7D5DF" BorderBrush="#587287" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="PRESS CYLINDER" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Text="{Binding PressingCylinderState}" HorizontalAlignment="Center" FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Grid Grid.Row="2" HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{Binding FixturePosition, Converter={StaticResource FixtureBrush}, ConverterParameter=LEFT}" Margin="4" Padding="12"><TextBlock Text="LEFT&#x0a;左" TextAlignment="Center" /></Border>
                                    <Border Grid.Column="1" Background="{Binding FixturePosition, Converter={StaticResource FixtureBrush}, ConverterParameter=MIDDLE}" Margin="4" Padding="12"><TextBlock Text="MIDDLE&#x0a;中" TextAlignment="Center" FontWeight="SemiBold" /></Border>
                                    <Border Grid.Column="2" Background="{Binding FixturePosition, Converter={StaticResource FixtureBrush}, ConverterParameter=RIGHT}" Margin="4" Padding="12"><TextBlock Text="RIGHT&#x0a;右" TextAlignment="Center" /></Border>
                                </Grid>
                            </Grid>
                            <Grid Grid.Row="2" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="FIXTURE POSITION / 夹具位置" Style="{StaticResource Muted}" />
                                    <TextBlock Text="{Binding FixturePosition}" FontSize="17" FontWeight="SemiBold" Foreground="#173148" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="PRODUCT DETECTION / 产品检测" Style="{StaticResource Muted}" />
                                    <TextBlock Text="{Binding ProductState}" FontSize="17" FontWeight="SemiBold" Foreground="#173148" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions><RowDefinition Height="1.1*" /><RowDefinition Height="0.9*" /></Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="STATION STATE / 工位状态" Style="{StaticResource SectionTitle}" />
                                <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Current mode / 当前模式" Foreground="#647887" /><TextBlock Grid.Column="1" Text="{Binding ModeName}" FontWeight="SemiBold" /></Grid>
                                <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Execution / 执行" Foreground="#647887" /><TextBlock Grid.Column="1" Text="{Binding RunStateText}" FontWeight="SemiBold" /></Grid>
                                <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Mode release / 模式释放" Foreground="#647887" /><Ellipse Grid.Column="1" Width="14" Height="14" Fill="{Binding ModeReleased, Converter={StaticResource BoolBrush}}" /></Grid>
                                <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Home position / 原位" Foreground="#647887" /><Ellipse Grid.Column="1" Width="14" Height="14" Fill="{Binding IsInHomePosition, Converter={StaticResource BoolBrush}}" /></Grid>
                                <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="EtherCAT" Foreground="#647887" /><Ellipse Grid.Column="1" Width="14" Height="14" Fill="{Binding BusOk, Converter={StaticResource BoolBrush}}" /></Grid>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="HMI token / 控制令牌" Foreground="#647887" /><TextBlock Grid.Column="1" Text="{Binding Token}" FontWeight="SemiBold" /></Grid>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="SAFETY / 安全回路" Style="{StaticResource SectionTitle}" />
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="18" Height="18" Margin="0,0,10,0" Fill="{Binding SafetyReady, Converter={StaticResource BoolBrush}}" />
                                    <TextBlock Text="{Binding SafetyState}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Text="E-stop · maintenance doors · safety door · common safety relay" Style="{StaticResource Muted}" Margin="28,10,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions><RowDefinition Height="1*" /><RowDefinition Height="1*" /><RowDefinition Height="1*" /></Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="BURSTER 2316" Style="{StaticResource SectionTitle}" />
                                <StackPanel Orientation="Horizontal"><Ellipse Width="14" Height="14" Margin="0,0,8,0" Fill="{Binding ResistantUnitState, Converter={StaticResource UnitStateBrush}}" /><TextBlock Text="Resistance meter / 电阻仪" FontWeight="SemiBold" /></StackPanel>
                                <TextBlock Text="{Binding ResistantState}" Style="{StaticResource Muted}" Margin="22,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="KISTLER maXYmos 5867C" Style="{StaticResource SectionTitle}" />
                                <StackPanel Orientation="Horizontal"><Ellipse Width="14" Height="14" Margin="0,0,8,0" Fill="{Binding KistlerUnitState, Converter={StaticResource UnitStateBrush}}" /><TextBlock Text="Force / displacement" FontWeight="SemiBold" /></StackPanel>
                                <TextBlock Text="{Binding KistlerState}" Style="{StaticResource Muted}" Margin="22,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="2" Style="{StaticResource Card}" BorderBrush="#E4B9B7">
                            <StackPanel>
                                <TextBlock Text="ACTIVE EVENTS / 当前报警" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding EventDecodeMessage}" Foreground="#6C7E8C" TextWrapping="Wrap" />
                                <TextBlock Text="Open EVENTS for timestamp, class, source and additional information. / 打开 EVENTS 查看时间、等级、来源与附加信息。" Foreground="#6C7E8C" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
                    </Grid>

                    <Grid Visibility="{Binding SelectedPageIndex, Converter={StaticResource PageVisibility}, ConverterParameter=1}">
                        <Grid Margin="0,0,14,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="290" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="350" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <Border Background="#173148" Padding="18,14">
                                        <StackPanel>
                                            <TextBlock Text="STATION / WP100" Foreground="White" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="UNIT TREE / Unit 层级" Foreground="#A9C4D5" FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                    <ListBox Grid.Row="1" ItemsSource="{Binding ManualUnits}" SelectedItem="{Binding SelectedManualUnit}"
                                             BorderThickness="0" Background="White" AutomationProperties.Name="Manual Unit tree">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="16,12" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="BorderBrush" Value="#E0E6EB" />
                                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="#173148" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Designator}" Foreground="#006EA8" FontSize="12" />
                                                        <TextBlock Text="{Binding Category}" Foreground="#7B8C98" FontSize="11" />
                                                    </StackPanel>
                                                    <Ellipse Grid.Column="1" Width="13" Height="13" Margin="8,0,0,0"
                                                             Fill="{Binding Available, Converter={StaticResource BoolBrush}}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <Border Background="#EDF3F6" BorderBrush="#D3DEE5" BorderThickness="1" Padding="16" Margin="0,0,0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding SelectedManualUnit.DisplayName}" FontSize="20" FontWeight="SemiBold" Foreground="#173148" />
                                                <TextBlock Text="{Binding SelectedManualUnit.Designator}" Foreground="#006EA8" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="UNIT STATE / Unit 状态" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding SelectedManualUnit.StateText}" FontWeight="SemiBold" Foreground="#173148" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding SelectedManualUnit.Actions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource ManualFunctionButton}" IsEnabled="{Binding CanExecute}"
                                                            Click="OnManualFunctionClick" AutomationProperties.Name="{Binding Label}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Label}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding Description}" Foreground="#6D7F8B" FontSize="11" TextWrapping="Wrap" Margin="0,4,12,0" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                <Ellipse Width="14" Height="14" Fill="{Binding Released, Converter={StaticResource BoolBrush}}" HorizontalAlignment="Right" />
                                                                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#526B7B" Margin="8,5,0,0" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="RELEASE &amp; INTERLOCKS / 释放与联锁" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="The PLC Release* outputs remain authoritative. Red means the function must not execute. / 以 PLC 的 Release* 输出为最终执行许可；红色时禁止动作。"
                                               Foreground="#647887" TextWrapping="Wrap" Margin="0,0,0,16" />
                                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Manual mode / 手动模式" /><TextBlock Grid.Column="1" Text="{Binding ModeName}" FontWeight="SemiBold" /></Grid>
                                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Manual functions active" /><Ellipse Grid.Column="1" Width="14" Height="14" Fill="{Binding ManualFunctionsActive, Converter={StaticResource BoolBrush}}" /></Grid>
                                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="A function is running" /><Ellipse Grid.Column="1" Width="14" Height="14" Fill="{Binding ManualFunctionRunning, Converter={StaticResource BoolBrush}}" /></Grid>
                                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Safety circuits / 安全回路" /><Ellipse Grid.Column="1" Width="14" Height="14" Fill="{Binding SafetyReady, Converter={StaticResource BoolBrush}}" /></Grid>
                                    <Separator Margin="0,5,0,14" />
                                    <TextBlock Text="SELECTED FUNCTION STATUS / 当前功能状态" Style="{StaticResource Muted}" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding SelectedManualUnit.Actions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,9">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Chinese}" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="#526B7B" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Background="#FFF4D6" BorderBrush="#E7C86C" BorderThickness="1" Padding="12" Margin="0,14,0,0">
                                        <TextBlock Text="Real manual writes are locked until Exec/Heartbeat release-on-disconnect is accepted. / 真机手动写入将在 Exec/Heartbeat 失联复位机制验收后开放。"
                                                   Foreground="#6C5617" TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid Visibility="{Binding SelectedPageIndex, Converter={StaticResource PageVisibility}, ConverterParameter=2}">
                        <Grid Margin="0,0,14,14">
                            <Border Style="{StaticResource Card}" BorderBrush="#D88984">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="EVENTS / 事件与报警" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="{Binding EventDecodeMessage}" Foreground="#647887" Margin="0,0,0,12" />
                                    </StackPanel>
                                    <DataGrid Grid.Row="1" ItemsSource="{Binding ActiveEvents}" AutoGenerateColumns="False"
                                              IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal" RowHeaderWidth="0" Background="White">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Time / 时间" Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="150" />
                                            <DataGridTextColumn Header="Class / 等级" Binding="{Binding ClassText}" Width="105" />
                                            <DataGridTextColumn Header="No." Binding="{Binding Number}" Width="70" />
                                            <DataGridTextColumn Header="Source / 来源" Binding="{Binding Source}" Width="150" />
                                            <DataGridTextColumn Header="Event / 报警" Binding="{Binding Text}" Width="*" />
                                            <DataGridTextColumn Header="Additional information / 附加信息" Binding="{Binding AdditionalInfo}" Width="1.5*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid Visibility="{Binding SelectedPageIndex, Converter={StaticResource PageVisibility}, ConverterParameter=3}">
                        <Grid Margin="0,0,14,14">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="370" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                        <Border Background="#173148" Padding="18,14">
                                            <StackPanel>
                                                <TextBlock Text="ETHERCAT TOPOLOGY / EtherCAT 拓扑" Foreground="White" FontSize="17" FontWeight="SemiBold" />
                                                <TextBlock Text="Master → coupler → modules / 主站 → 耦合器 → 模块" Foreground="#A9C4D5" FontSize="11" />
                                            </StackPanel>
                                        </Border>
                                        <TreeView Grid.Row="1" ItemsSource="{Binding EtherCatTopology}"
                                                  SelectedItemChanged="OnEtherCatSelectionChanged"
                                                  BorderThickness="0" Background="White" Padding="8"
                                                  AutomationProperties.Name="EtherCAT hierarchical topology">
                                            <TreeView.ItemContainerStyle>
                                                <Style TargetType="TreeViewItem">
                                                    <Setter Property="IsExpanded" Value="True" />
                                                    <Setter Property="Padding" Value="2" />
                                                </Style>
                                            </TreeView.ItemContainerStyle>
                                            <TreeView.ItemTemplate>
                                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                                    <Grid Margin="2,5">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <Ellipse Width="12" Height="12" Fill="{Binding IsOperational, Converter={StaticResource BoolBrush}}" VerticalAlignment="Top" Margin="0,4,0,0" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="#173148" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding Designator}" Foreground="#006EA8" FontSize="11" />
                                                            <TextBlock Text="{Binding DeviceType}" Foreground="#71838F" FontSize="10" />
                                                        </StackPanel>
                                                        <Border Grid.Column="2" Background="#E8EEF2" Padding="7,3" Margin="8,0,0,0" VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding StateText}" FontSize="10" FontWeight="SemiBold" />
                                                        </Border>
                                                    </Grid>
                                                </HierarchicalDataTemplate>
                                            </TreeView.ItemTemplate>
                                        </TreeView>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#EDF3F6" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="BUS" Style="{StaticResource Muted}" /><TextBlock Text="{Binding BusOk}" FontWeight="Bold" /></StackPanel></Border>
                                            <Border Grid.Column="1" Background="#EDF3F6" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="MASTER" Style="{StaticResource Muted}" /><TextBlock Text="{Binding MasterOk}" FontWeight="Bold" /></StackPanel></Border>
                                            <Border Grid.Column="2" Background="#EDF3F6" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="SLAVES" Style="{StaticResource Muted}" /><TextBlock Text="{Binding DetectedSlaves, StringFormat={}{0} detected}" FontWeight="Bold" /></StackPanel></Border>
                                            <Border Grid.Column="3" Background="#EDF3F6" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="CONFIGURED" Style="{StaticResource Muted}" /><TextBlock Text="{Binding ConfiguredSlaves}" FontWeight="Bold" /></StackPanel></Border>
                                            <Border Grid.Column="4" Background="#EDF3F6" Padding="12"><StackPanel><TextBlock Text="LOST FRAMES" Style="{StaticResource Muted}" /><TextBlock Text="{Binding LostFrames}" FontWeight="Bold" /></StackPanel></Border>
                                        </Grid>

                                        <Border Grid.Row="1" Background="#F8FAFB" BorderBrush="#D4DEE5" BorderThickness="1" Padding="14" Margin="0,12,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /><ColumnDefinition Width="130" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding SelectedEtherCatNode.DisplayName}" FontSize="18" FontWeight="SemiBold" Foreground="#173148" />
                                                    <TextBlock Text="{Binding SelectedEtherCatNode.Designator}" Foreground="#006EA8" />
                                                    <TextBlock Text="{Binding SelectedNodeScopeText}" Foreground="#71838F" FontSize="11" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1"><TextBlock Text="ADDRESS" Style="{StaticResource Muted}" /><TextBlock Text="{Binding SelectedEtherCatNode.AddressText}" FontWeight="SemiBold" /></StackPanel>
                                                <StackPanel Grid.Column="2"><TextBlock Text="STATE" Style="{StaticResource Muted}" /><TextBlock Text="{Binding SelectedEtherCatNode.StateText}" FontWeight="SemiBold" /></StackPanel>
                                                <StackPanel Grid.Column="3"><TextBlock Text="PROCESS DATA" Style="{StaticResource Muted}" /><TextBlock Text="{Binding SelectedEtherCatNode.ProcessDataText}" FontWeight="SemiBold" /></StackPanel>
                                            </Grid>
                                        </Border>

                                        <Grid Grid.Row="2">
                                            <DataGrid ItemsSource="{Binding SelectedSlaveIoChannels}" AutoGenerateColumns="False" IsReadOnly="True"
                                                      CanUserAddRows="False" RowHeaderWidth="0" GridLinesVisibility="Horizontal">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Slave" Binding="{Binding SlaveIndex}" Width="55" />
                                                    <DataGridTextColumn Header="Ch." Binding="{Binding Channel}" Width="45" />
                                                    <DataGridTextColumn Header="I/O" Binding="{Binding Direction}" Width="48" />
                                                    <DataGridTextColumn Header="BMK" Binding="{Binding Bmk}" Width="145" />
                                                    <DataGridTextColumn Header="Description / 描述" Binding="{Binding Description}" Width="*" />
                                                    <DataGridTextColumn Header="Value / 值" Binding="{Binding ValueText}" Width="90" />
                                                    <DataGridTextColumn Header="Quality" Binding="{Binding Quality}" Width="95" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <Border Background="White" Visibility="{Binding SelectedNodeIsKistler, Converter={StaticResource BoolVisibility}}">
                                                <Grid>
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                                    <TextBlock Text="KISTLER SEMANTIC DATA / Kistler 语义数据（raw PDO 未发布）" Style="{StaticResource SectionTitle}" />
                                                    <DataGrid Grid.Row="1" ItemsSource="{Binding DeviceDataItems}" AutoGenerateColumns="False" IsReadOnly="True"
                                                              CanUserAddRows="False" RowHeaderWidth="0" GridLinesVisibility="Horizontal">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Signal / 信号" Binding="{Binding Label}" Width="*" />
                                                            <DataGridTextColumn Header="Value / 值" Binding="{Binding Value}" Width="180" />
                                                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="65" />
                                                            <DataGridTextColumn Header="Quality" Binding="{Binding Quality}" Width="95" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>

                    <Grid Visibility="{Binding SelectedPageIndex, Converter={StaticResource PageVisibility}, ConverterParameter=4}">
                        <Grid Margin="0,0,14,14">
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="DATA / 数据" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="Current StationData and TypeData values; DataSetManager staging values are intentionally excluded. / 当前 StationData 与 TypeData；不显示 DataSetManager 暂存区。" Foreground="#647887" />
                                    </StackPanel>
                                    <TabControl Grid.Row="1" Margin="0,14,0,0">
                                        <TabItem Header="StationData / 工位数据">
                                            <DataGrid ItemsSource="{Binding StationDataItems}" AutoGenerateColumns="False" IsReadOnly="True"
                                                      CanUserAddRows="False" RowHeaderWidth="0" GridLinesVisibility="Horizontal">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Group / 分组" Binding="{Binding Group}" Width="140" />
                                                    <DataGridTextColumn Header="Parameter / 参数" Binding="{Binding Label}" Width="*" />
                                                    <DataGridTextColumn Header="Value / 当前值" Binding="{Binding Value}" Width="260" />
                                                    <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="70" />
                                                    <DataGridTextColumn Header="Quality" Binding="{Binding Quality}" Width="110" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </TabItem>
                                        <TabItem Header="TypeData / 产品型号数据">
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                                <TextBlock Text="A740–A743 are retained CpStudio template fields and are marked legacy; they are shown for transparency. / A740–A743 是 CpStudio 保留模板字段，标记为 legacy。" Foreground="#8A681B" Margin="8" />
                                                <DataGrid Grid.Row="1" ItemsSource="{Binding TypeDataItems}" AutoGenerateColumns="False" IsReadOnly="True"
                                                          CanUserAddRows="False" RowHeaderWidth="0" GridLinesVisibility="Horizontal">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Group / 分组" Binding="{Binding Group}" Width="150" />
                                                        <DataGridTextColumn Header="Parameter / 参数" Binding="{Binding Label}" Width="*" />
                                                        <DataGridTextColumn Header="Value / 当前值" Binding="{Binding Value}" Width="300" />
                                                        <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="70" />
                                                        <DataGridTextColumn Header="Quality" Binding="{Binding Quality}" Width="110" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </Grid>
                                        </TabItem>
                                    </TabControl>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <Border Grid.Row="2" Panel.ZIndex="20" Background="#E6EDF1F4" Margin="0,0,14,14"
                        Visibility="{Binding IsDataUnavailable, Converter={StaticResource BoolVisibility}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="○" FontSize="48" Foreground="#8195A4" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding DataQualityText}" FontSize="18" FontWeight="SemiBold" Foreground="#435D70" HorizontalAlignment="Center" />
                        <TextBlock Text="Use DEMO for offline review or open connection settings for ctrlX OPC UA. / 离线评审请选择“演示”，连接 PLC 请打开“连接设置”。"
                                   Foreground="#647887" Margin="0,8,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="3" Background="#F6CE46" BorderBrush="#D5AD27" BorderThickness="1" Padding="18,10" CornerRadius="2" Margin="0,0,14,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding AutoInfoIndex, StringFormat=STEP {0}}" FontWeight="Bold" Foreground="#594B13" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AutoInfoChinese}" FontSize="20" FontWeight="SemiBold" Foreground="#372F12" />
                            <TextBlock Text="{Binding AutoInfoEnglish}" FontSize="12" Foreground="#6C5A18" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="OPERATOR GUIDANCE / 操作提示" Foreground="#6C5A18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#DCE4EA" BorderBrush="#C3CFD8" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="Independent Windows HMI · same PLC symbols · no PLC changes" Foreground="#536A7A" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding ModeRequestMessage}" Foreground="#536A7A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding LastUpdateText, StringFormat=Last update  {0}}" Foreground="#536A7A" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
