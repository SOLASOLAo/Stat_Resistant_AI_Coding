  "--codesys-profile",
  "ctrlX PLC 2.6.8",
  "--workspace",
  "C:\\Engineering\\BPP_ResistantStation",
  "--mode",
  "persistent",
]
startup_timeout_sec = 120
tool_timeout_sec = 180
enabled = true
