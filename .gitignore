# 方法论/模板仓库本体（旁级参考，不嵌套入库）
vibe-coding-templates/
ctrlx-ai-coding/

# CODESYS/ctrlX 编译缓存、用户配置和本地备份
*.precompilecache
*.Sync.json
*.project.~u
*.~u
*.opt
*.Backup
*.Backup.*
*.compiled-library
*.projectarchive

# 加密工程容器由受控集成仓库/IDE 管理，不进入 AI 工程仓库
*.project
*.project.bak_*

# 运行数据、请求、快照、报告和日志
data/*
!data/.gitkeep
*.log

# Baseline candidates and AI triage may contain project-specific BMK/topology.
# Keep them local for human review; only deliberately sanitized review evidence is tracked.
docs/reviews/*-baseline-candidate-*.json
docs/reviews/*-baseline-triage-*.md
docs/reviews/*-triage-*.md

# Python/测试缓存
__pycache__/
*.pyc
.pytest_cache/

# .NET HMI build/user state
**/bin/
**/obj/
.vs/
*.user
*.suo
src/hmi/**/appsettings.local.json
src/hmi/**/pki/

# 大文件和原始资料
*.zip
*.pdf

# 临时文件
~$*
*.tmp
Thumbs.db
